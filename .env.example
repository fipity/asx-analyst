# Copy to .env and edit. Every setting is optional; the defaults are shown.

# --- Web ---
APP_PORT=8000
# 0.0.0.0 = all interfaces (LAN). Set to the server's LAN IP to bind one address only.
BIND_IP=0.0.0.0
# Optional login password. Empty = no login.
APP_PASSWORD=
# Cookie signing key. Empty = auto-generated and stored in ./data/secret.key
SECRET_KEY=

# --- Universe ---
# asx50 | asx100 | asx200 | asx300   (asx100/asx300 are labelled approximations)
INDEX_UNIVERSE=asx200

# --- Backtest + paper trading costs ---
BROKERAGE_PER_TRADE=5.0
SLIPPAGE_BPS=10
PAPER_CAPITAL=50000
# Stocks held by the model strategy and used for Buy/Sell signals; walk-forward test start
BACKTEST_TOP_N=10
BACKTEST_START=2020-01-01

# --- Maintenance ---
# Weekly (Sunday 03:30) gzipped database backups kept in data/backups; 0 turns them off
BACKUP_KEEP=4

# --- Backfill depth ---
ANNOUNCEMENT_BACKFILL_YEARS=10
ASIC_BACKFILL_YEARS=10
DIRECTOR_TRADES_BACKFILL_DAYS=365

# --- Politeness (minimum seconds between requests to one host) ---
RATE_LIMIT_SECONDS=1.0

# --- News (phase 4) ---
BING_NEWS_ENABLED=false

# --- Optional AI summaries of price-sensitive announcements (Anthropic API key). Empty = off. ---
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5
# followed = watchlist + holdings (default) | universe = every index member's price-sensitive announcements
LLM_SCOPE=followed
# Max AI summaries per 24 hours
LLM_DAILY_LIMIT=40

# --- Alerts (phase 7). Empty = off. ---
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=
WEBHOOK_URL=
QUIET_HOURS_START=22:00
QUIET_HOURS_END=07:00
# What to alert on (true/false)
ALERT_SIGNALS=true
ALERT_ANNOUNCEMENTS=true
ALERT_JOBS=true
# Base URL used for links inside alerts (optional)
# APP_URL=http://<server-ip>:8000

LOG_LEVEL=INFO
